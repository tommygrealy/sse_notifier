[Unit]
Description=inpho-sse Server-Sent Events notifier
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/inpho-sse
EnvironmentFile=/opt/inpho-sse/.env
ExecStart=/opt/inpho-sse/.venv/bin/python run.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
